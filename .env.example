# The only configuration this engine needs. It calls no external service,
# so there are no API keys.
#
# This matches the defaults in docker-compose.yml. If you override the
# POSTGRES_* variables below, update the connection string to match.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/rag_demo

# Optional — only if you do not want the compose defaults.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=rag_demo
